generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAISSIER
}

model SchoolYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  Class[]
  fees     Fee[]
  students Student[]
}

model Class {
  id           String   @id @default(cuid())
  name         String
  level        String
  schoolYearId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  students   Student[]
  fees       Fee[]

  @@index([schoolYearId])
}

model Student {
  id           String   @id @default(cuid())
  matricule    String   @unique
  firstName    String
  lastName     String
  middleName   String?
  gender       String
  birthDate    DateTime
  status       String   @default("active")
  classId      String
  schoolYearId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class      Class      @relation(fields: [classId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  fees       Fee[]
  payments   Payment[]

  @@index([classId])
  @@index([schoolYearId])
  @@index([status])
  @@index([schoolYearId, classId])
}

model Fee {
  id           String    @id @default(cuid())
  name         String
  amount       Decimal   @db.Decimal(10, 2)
  currency     String    @default("USD")
  dueDate      DateTime?
  status       String    @default("active")
  schoolYearId String
  classId      String?
  studentId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  class      Class?     @relation(fields: [classId], references: [id])
  student    Student?   @relation(fields: [studentId], references: [id])
  payments   Payment[]

  @@index([schoolYearId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
}

model Payment {
  id                 String    @id @default(cuid())
  studentId          String
  feeId              String
  amount             Decimal   @db.Decimal(10, 2)
  paymentDate        DateTime  @default(now())
  paymentMode        String
  reference          String?
  receiptNumber      String?   @unique
  status             String    @default("confirmed")
  cancellationReason String?
  cancelledAt        DateTime?
  userId             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  fee     Fee     @relation(fields: [feeId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([feeId])
  @@index([userId])
  @@index([status])
  @@index([paymentDate])
  @@index([status, paymentDate])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(CAISSIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]
  auditLogs AuditLog[]
}

model InstitutionSettings {
  id            String   @id @default("default")
  name          String
  legalName     String?
  address       String?
  city          String?
  country       String?
  phone         String?
  email         String?
  website       String?
  logoUrl       String?
  currency      String   @default("USD")
  receiptPrefix String   @default("PAY")
  primaryColor  String   @default("#3b82f6")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  module      String
  entityType  String?
  entityId    String?
  description String
  metadata    Json?
  userId      String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([module])
  @@index([userId])
}
